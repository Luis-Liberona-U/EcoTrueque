<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PublicarObjetoActivity">

  <TextView
      android:id="@+id/txtTituloPublicar"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="32dp"
      android:text="Publicar un Objeto"
      android:textSize="28sp"
      android:textStyle="bold"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <EditText
      android:id="@+id/edtNombreObjeto"
      android:layout_width="218dp"
      android:layout_height="50dp"
      android:layout_marginTop="32dp"
      android:ems="10"
      android:hint="Nombre del Objeto"
      android:inputType="textCapSentences"
      android:textSize="16sp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/txtTituloPublicar" />

  <TextView
      android:id="@+id/txtCategoria"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:text="Selecciona una categoría"
      android:textSize="18sp"
      android:textStyle="bold"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/edtNombreObjeto" />

  <RadioGroup
      android:id="@+id/rgCategoria"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="vertical"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/txtCategoria">

    <RadioButton
        android:id="@+id/rbRopa"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Ropa"
        android:textSize="16sp" />

    <RadioButton
        android:id="@+id/rbLibros"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Libros"
        android:textSize="16sp" />

    <RadioButton
        android:id="@+id/rbTecnologia"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Tecnología"
        android:textSize="16sp" />

  </RadioGroup>

  <Button
      android:id="@+id/btnPublicar"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      android:layout_marginTop="24dp"
      android:text="Publicar"
      android:textSize="18sp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/rgCategoria" />
</androidx.constraintlayout.widget.ConstraintLayout>